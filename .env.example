#member 1
# Spring Boot reads this as a properties file. Copy to .env and fill your password.
DB_URL=jdbc:mysql://localhost:3306/mini_store?allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=mini_store_app
DB_PASSWORD=replace_with_your_local_password
SERVER_PORT=8080

# Optional Phase 2 settings. The defaults are shown.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# SESSION_COOKIE_SECURE=false

#member 4
# AI settings. The key is read by the backend only and is never sent to the browser.
# Create a key in Google AI Studio and keep .env out of Git.
# AI_API_KEY=your_google_ai_studio_key
# Optional AI overrides. The defaults are shown.
# AI_MODEL=gemini-3.5-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_TIMEOUT_SECONDS=30
# AI_MAX_OUTPUT_TOKENS=400
# AI_THINKING_BUDGET=-1
# REVIEWS_MINIMUM_FOR_SUMMARY=3
# REVIEW_SUMMARY_TTL_HOURS=168
