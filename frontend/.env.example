#member 4
# The dev server proxies /api to http://localhost:8080 (see vite.config.js).
# Set VITE_API_PROXY_TARGET if the Spring Boot app runs on another port.
# For a separately hosted frontend, use the full backend URL for VITE_API_BASE_URL
# and add its origin to CORS_ALLOWED_ORIGINS in the backend environment.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8080
